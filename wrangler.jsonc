{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dataku2026",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    // PENTING: harus "dist" (hasil scripts/build.js), BUKAN "public".
    // Tanpa file ini, Wrangler auto-detect assets.directory ke "public"
    // (folder source mentah, masih berisi placeholder APP_MODE='mock')
    // setiap deploy — itu penyebab banner MODE DEMO tetap muncul di
    // production meski environment variable sudah diisi benar.
    "directory": "dist"
  }
}
